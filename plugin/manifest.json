{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/plugin-sdk-v1/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.github.zhengcan.dbx-notebook",
  "name": "SQL Notebook",
  "version": "0.6.0-rc1",
  "publisher": "canzheng",
  "description": "Notebook-style SQL workbench for DBX.",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.6.48",
    "host_api": "^1.4"
  },
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-plugin"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "io.github.zhengcan.dbx-notebook.notebook",
      "label": "SQL Notebook",
      "description": "Notebook-style SQL workbench.",
      "icon": "assets/plugin.svg"
    },
    {
      "type": "context-menu",
      "id": "io.github.zhengcan.dbx-notebook.use-connection",
      "label": "新建 SQL 笔记本",
      "menu": "connection",
      "action": {
        "type": "open-workbench",
        "workbench": "io.github.zhengcan.dbx-notebook.notebook"
      }
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "SQL Notebook",
      "description": "DBX 的笔记本式 SQL 工作台。",
      "contributions": {
        "io.github.zhengcan.dbx-notebook.notebook": {
          "label": "SQL 笔记本"
        }
      }
    },
    "en": {
      "contributions": {
        "io.github.zhengcan.dbx-notebook.use-connection": {
          "label": "New SQL Notebook"
        }
      }
    }
  },
  "permissions": [
    "host.data:read",
    "host.schema:read",
    "host.ai",
    "host.storage",
    "host.workbench",
    "host.connections:read"
  ],
  "homepage": "https://github.com/zhengcan/dbx-notebook",
  "source": "https://github.com/zhengcan/dbx-notebook"
}
