{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/plugin-sdk-v1/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.github.zhengcan.spike-vega",
  "name": "Vega Sandbox",
  "version": "0.1.0",
  "publisher": "canzheng",
  "description": "Vega Sandbox plugin for DBX.",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": "1"
  },
  "entrypoints": {
    "ui": {
      "root": "ui",
