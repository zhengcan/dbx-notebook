      "icon": "assets/plugin.svg"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "Vega Sandbox",
      "description": "Vega Sandbox plugin for DBX.",
      "contributions": {
        "io.github.zhengcan.spike-vega.workbench": {
          "label": "Vega Sandbox",
